# frontend/ and backend/ each carry their own .gitignore.
# This file covers only what is common to the whole repo.

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Logs and scratch
*.log

# Secrets, belt and braces -- never commit a real .env from anywhere.
.env
.env.*
!.env.example
!**/.env.example
