# Copy to .env and fill in. Never commit the real .env.
ENV=local
DEBUG=true

# Local: docker compose up -d  |  Staging/prod: your Neon connection string
DATABASE_URL=postgresql+psycopg://nexly:nexly@localhost:5432/nexly
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# Expo dev server and the Vite web app
CORS_ORIGINS=["http://localhost:8081","http://localhost:5173"]

# --- Fapshi (mobile money). WEB CHECKOUT ONLY. ---
# Sandbox: https://sandbox.fapshi.com   Live: https://live.fapshi.com
FAPSHI_BASE_URL=https://sandbox.fapshi.com
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_WEBHOOK_SECRET=

# --- LiveKit (live classroom) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Platform take rate in basis points (1500 = 15.00%)
PLATFORM_FEE_BPS=1500
