# Copy to .env and fill in. Never commit the real .env.
ENV=local
DEBUG=true

# Local: docker compose up -d  |  Staging/prod: your Neon connection string
DATABASE_URL=postgresql+psycopg://nexly:nexly@localhost:5432/nexly
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# Expo dev server and the Vite web app
CORS_ORIGINS=["http://localhost:8081","http://localhost:5173"]

# --- Fapshi (mobile money). WEB CHECKOUT ONLY. ---
# Sandbox: https://sandbox.fapshi.com   Live: https://live.fapshi.com
FAPSHI_BASE_URL=https://sandbox.fapshi.com
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_WEBHOOK_SECRET=

# --- Sign in with Google / Apple ---
# Audience values the ID tokens are issued for.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=com.nexly.app

# --- LiveKit (live classroom) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cloudflare R2 (object storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nexly-media
R2_PUBLIC_BASE_URL=
MAX_UPLOAD_BYTES=536870912

# --- Resend (transactional email) ---
RESEND_API_KEY=
EMAIL_FROM=Nexly <no-reply@nexly.app>

# --- Firebase Cloud Messaging (push) ---
FCM_PROJECT_ID=
# Path to the service-account JSON. Never commit the file itself.
FCM_CREDENTIALS_FILE=

# --- PostHog (product analytics) ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Moderation ---
# Leave the URL blank to use the built-in heuristic only.
MODERATION_API_URL=
MODERATION_API_KEY=
MODERATION_FLAG_THRESHOLD=0.50
MODERATION_BLOCK_THRESHOLD=0.85

# --- Group sessions & reminders ---
MAX_GROUP_SIZE=6
BOOKING_REMINDER_LEAD_MINUTES=60

# How long teacher earnings are held before becoming payable.
PAYOUT_HOLD_HOURS=48

# Platform take rate in basis points (1500 = 15.00%)
PLATFORM_FEE_BPS=1500
